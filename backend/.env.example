# ==========================================
# Domain & Target Configuration
# ==========================================
# Domain is SaaS, deliberately singular.
# AWS Amplify is intentionally excluded for now because it would add noise
# before the pipeline itself is validated — it is a candidate for a later stage, not this one.
TARGET_COMPANY=Vercel
COMPETITORS=Netlify,Cloudflare Pages,Cloudflare Workers

# ==========================================
# Data Sources Configuration
# ==========================================
# These are the only two sources for Stage 1:
# - news: covers announcements, launches, partnerships, and strategic changes.
# - github: covers technical and product-development activity.
# Pricing pages, job postings, patents, and research papers are deliberately
# excluded until these two are proven, each being its own reliability problem.
SOURCES=news,github,jobs,pricing,research

# ==========================================
# Database & Multi-Tenancy Configuration
# ==========================================
SUPABASE_DB_URL=postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
OWNER_TENANT_ID=00000000-0000-0000-0000-000000000000